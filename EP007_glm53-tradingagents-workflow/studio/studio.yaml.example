api:
  base_url: http://localhost
  username: admin
  password: ${STUDIO_API_PASSWORD}
  timeout: 30
llm:
  base_url: https://open.bigmodel.cn/api/paas/v4
  api_key: ${ZHIPU_API_KEY}
  model: glm-5.3
  max_tokens: 4096
  temperature: 0.3
  extra_body:
    reasoning_effort: low
data:
  ta_dir: /path/to/TradingAgents-CN/data
notify:
  report_url_prefix: http://localhost:8890
  channels:
    feishu:
      webhook: ${FEISHU_WEBHOOK}
      secret: ''
compare:
  defaults:
    depth: 标准
    analysts:
    - market
    - fundamentals
    - news
    concurrency: 2
    poll_interval: 10
  prices:
    glm-5.3:
      input: 0.0
      output: 0.0
  aliases:
    <API模型ID>: <显示名>
replay:
  theme: dark
  exports_dir: data/exports
cron:
  timezone: Asia/Shanghai
  jobs:
  - name: 早盘简报
    schedule: 30 9 * * 1-5
    symbol: 002594
    depth: 标准
    pipeline:
    - digest
    - notify
